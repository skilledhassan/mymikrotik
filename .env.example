# MikroTik Router (single-router panel)
MIKROTIK_HOST=
MIKROTIK_USER=
MIKROTIK_PASSWORD=
MIKROTIK_PORT=8728

# Web panel
PORT=3000

# MySQL / MariaDB (customer records, audit log)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

# Create the tables first:
#   mysql -u <DB_USER> -p<DB_PASSWORD> -h <DB_HOST> <DB_NAME> < database.sql

# Automatic expiry sweep inside the panel (true/false).
# When true, active customers whose expiry_date has passed are disabled
# on the router and marked expired.  Also runnable manually with:
#   npm run expire
AUTO_DISABLE_EXPIRED=false

# How often the in-process expiry sweep runs (milliseconds).
# Default: 1 hour.
EXPIRY_CHECK_INTERVAL_MS=3600000

# How often the router connection watchdog checks/reconnects (milliseconds).
# Default: 5 seconds.
WATCHDOG_INTERVAL_MS=5000

# Remote access to customer routers (dst-nat port redirect).
# The admin clicks "Remote" on an online customer; the panel creates:
#   /ip firewall nat add chain=dstnat in-interface=ether1 protocol=tcp \
#       dst-port=9001 action=dst-nat to-addresses=<user ip> to-ports=80 \
#       comment="REMOTE PPPoE ROUTER"
# and opens http://<MIKROTIK_HOST>:9001 in the browser.
REMOTE_ACCESS_PORT=9001
REMOTE_ACCESS_INTERFACE=ether1
REMOTE_ACCESS_TO_PORT=80

# Admin Panel Authentication
# Default login credentials for the panel (stored in plain text):
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# OpenWA WhatsApp Gateway (https://github.com/rmyndharis/OpenWA)
OPENWA_BASE_URL=http://localhost:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_ID=default
OPENWA_DEFAULT_COUNTRY_CODE=92
WHATSAPP_ENABLED=true
WHATSAPP_DAYS_BEFORE=2